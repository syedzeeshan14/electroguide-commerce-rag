# Copy to secrets.toml on your computer. Never commit the completed file.
OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-4o-mini"
OPENAI_EMBEDDING_MODEL = "text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS = "512"
# B2C Commerce SCAPI, not your Lightning login/password.
SALESFORCE_SHORT_CODE = ""
SALESFORCE_ORGANIZATION_ID = ""
SALESFORCE_SITE_ID = ""
# Short-lived SLAS shopper access token obtained using your configured OAuth flow.
SALESFORCE_ACCESS_TOKEN = ""

# Lightning Commerce / Salesforce-platform setup (separate from B2C settings above).
CATALOG_SOURCE = "demo"  # Switch to "lightning_snapshot" only after a successful sync.
SALESFORCE_INSTANCE_URL = ""  # Your HTTPS My Domain base URL, not a Lightning page URL.
SALESFORCE_API_VERSION = ""  # Blank discovers an advertised version.
SALESFORCE_CLIENT_ID = ""
SALESFORCE_CLIENT_SECRET = ""
SALESFORCE_WEBSTORE_ID = ""
SALESFORCE_PRICEBOOK_ID = ""
SALESFORCE_EFFECTIVE_ACCOUNT_ID = ""  # Authorized buyer context if required.
SALESFORCE_MULTI_CURRENCY = "false"  # Set true for a multicurrency org; sync filters USD.
