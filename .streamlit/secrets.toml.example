# Copy to secrets.toml locally. Never commit a completed secrets file.
OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-4o-mini"
OPENAI_EMBEDDING_MODEL = "text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS = "512"

# Active project path: standard Salesforce Product2 catalog. No Commerce store needed.
CATALOG_SOURCE = "demo"  # After sync: "salesforce_catalog_snapshot"
SALESFORCE_INSTANCE_URL = ""  # HTTPS My Domain base URL, not a Lightning page URL.
SALESFORCE_API_VERSION = ""  # Blank discovers a supported version.
SALESFORCE_CLIENT_ID = ""
SALESFORCE_CLIENT_SECRET = ""
SALESFORCE_ACCESS_TOKEN = ""  # Optional platform OAuth token; takes precedence over client credentials.
SALESFORCE_CATALOG_PRICING = "demo_metadata"  # USD demo price stored in Product2.Description.
SALESFORCE_PRICEBOOK_ID = ""  # Required only for optional "pricebook" pricing mode.
SALESFORCE_PRICEBOOK_CURRENCY = ""  # Must be "USD" after actual verification for pricebook mode.
SALESFORCE_MULTI_CURRENCY = "false"

# Legacy store-based connectors: unused by the selected Product2 integration.
SALESFORCE_WEBSTORE_ID = ""
SALESFORCE_EFFECTIVE_ACCOUNT_ID = ""
SALESFORCE_SHORT_CODE = ""
SALESFORCE_ORGANIZATION_ID = ""
SALESFORCE_SITE_ID = ""

# Optional comma-separated exact public image hostnames, only for trusted external/CDN images.
SALESFORCE_IMAGE_HOSTS = ""
